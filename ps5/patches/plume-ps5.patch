+    static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL ps5PlumeGetInstanceProcAddr(VkInstance instance, const char *pName) {
+        if (vk_icdGetInstanceProcAddr == nullptr || pName == nullptr) {
