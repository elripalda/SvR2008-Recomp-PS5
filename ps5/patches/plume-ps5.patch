+        }
+        PFN_vkVoidFunction fn = vk_icdGetInstanceProcAddr(instance, pName);
+        if (fn != nullptr) {
+            return fn;
+        }
+        if (strcmp(pName, "vkGetPhysicalDeviceProperties2") == 0) {
+            return vk_icdGetInstanceProcAddr(instance, "vkGetPhysicalDeviceProperties2KHR");
+        }
+        if (strcmp(pName, "vkGetPhysicalDeviceFeatures2") == 0) {
+            return vk_icdGetInstanceProcAddr(instance, "vkGetPhysicalDeviceFeatures2KHR");
+        }
+        return nullptr;
+    }
+
+    static VkResult createPs5DisplaySurface(VkInstance instance, VkPhysicalDevice physicalDevice, VkSurfaceKHR *outSurface) {
+        (void)sceSystemServiceHideSplashScreen();
+        if (instance == VK_NULL_HANDLE || physicalDevice == VK_NULL_HANDLE || outSurface == nullptr) {
+            return VK_ERROR_INITIALIZATION_FAILED;
+        }
+        if (!vkGetPhysicalDeviceDisplayPropertiesKHR || !vkGetPhysicalDeviceDisplayPlanePropertiesKHR ||
+            !vkGetDisplayModePropertiesKHR || !vkCreateDisplayPlaneSurfaceKHR) {
+            fprintf(stderr, "[plume-ps5] VK_KHR_display entry points are not available.\n");
+            return VK_ERROR_EXTENSION_NOT_PRESENT;
+        }
+
+        uint32_t displayCount = 0;
+        VkResult res = vkGetPhysicalDeviceDisplayPropertiesKHR(physicalDevice, &displayCount, nullptr);
+        if (res != VK_SUCCESS || displayCount == 0) {
+            fprintf(stderr, "[plume-ps5] No displays reported by physical device (res=%d, count=%u).\n", res, displayCount);
+            return VK_ERROR_INITIALIZATION_FAILED;
+        }
+        std::vector<VkDisplayPropertiesKHR> displays(displayCount);
+        res = vkGetPhysicalDeviceDisplayPropertiesKHR(physicalDevice, &displayCount, displays.data());
+        if (res != VK_SUCCESS) {
+            return res;
+        }
+
+        uint32_t planeCount = 0;
+        res = vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physicalDevice, &planeCount, nullptr);
+        if (res != VK_SUCCESS || planeCount == 0) {
+            fprintf(stderr, "[plume-ps5] No display planes reported by physical device (res=%d, count=%u).\n", res, planeCount);
+            return VK_ERROR_INITIALIZATION_FAILED;
+        }
+        std::vector<VkDisplayPlanePropertiesKHR> planes(planeCount);
+        res = vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physicalDevice, &planeCount, planes.data());
+        if (res != VK_SUCCESS) {
+            return res;
+        }
+
+        VkDisplayKHR chosenDisplay = VK_NULL_HANDLE;
+        VkDisplayModeKHR chosenMode = VK_NULL_HANDLE;
+        VkExtent2D chosenExtent = { 3840, 2160 };
+        for (uint32_t i = 0; i < displayCount && chosenMode == VK_NULL_HANDLE; ++i) {
+            uint32_t modeCount = 0;
+            if (vkGetDisplayModePropertiesKHR(physicalDevice, displays[i].display, &modeCount, nullptr) != VK_SUCCESS || modeCount == 0) {
+                continue;
+            }
+            std::vector<VkDisplayModePropertiesKHR> modes(modeCount);
+            if (vkGetDisplayModePropertiesKHR(physicalDevice, displays[i].display, &modeCount, modes.data()) != VK_SUCCESS) {
+                continue;
+            }
+            chosenDisplay = displays[i].display;
+            chosenMode = modes[0].displayMode;
+            chosenExtent = modes[0].parameters.visibleRegion;
+            for (uint32_t m = 0; m < modeCount; ++m) {
+                if (modes[m].parameters.visibleRegion.width == 3840 && modes[m].parameters.visibleRegion.height == 2160) {
+                    chosenMode = modes[m].displayMode;
+                    chosenExtent = modes[m].parameters.visibleRegion;
+                    break;
+                }
+            }
+        }
+
+        if (chosenMode == VK_NULL_HANDLE) {
+            fprintf(stderr, "[plume-ps5] No usable display mode found.\n");
+            return VK_ERROR_INITIALIZATION_FAILED;
+        }
+
+        uint32_t chosenPlane = UINT32_MAX;
+        for (uint32_t i = 0; i < planeCount; ++i) {
+            if (planes[i].currentDisplay == VK_NULL_HANDLE || planes[i].currentDisplay == chosenDisplay) {
+                chosenPlane = i;
+                break;
+            }
+        }
+        if (chosenPlane == UINT32_MAX) {
+            chosenPlane = 0;
+        }
+
+        VkDisplaySurfaceCreateInfoKHR surfaceCreateInfo = {};
+        surfaceCreateInfo.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+        surfaceCreateInfo.displayMode = chosenMode;
+        surfaceCreateInfo.planeIndex = chosenPlane;
+        surfaceCreateInfo.planeStackIndex = planes[chosenPlane].currentStackIndex;
+        surfaceCreateInfo.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+        surfaceCreateInfo.globalAlpha = 1.0f;
+        surfaceCreateInfo.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+        surfaceCreateInfo.imageExtent = chosenExtent;
+
+        return vkCreateDisplayPlaneSurfaceKHR(instance, &surfaceCreateInfo, nullptr, outSurface);
+    }
+#endif
